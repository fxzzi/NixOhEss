+static int test_gif_animation_disabled(void) {
+  state.config.animation_enabled = false;
+  TEST_ASSERT(chroma_image_load(&image, gif_path, &state.config, 2, 1) == CHROMA_OK,
+              "GIF loads as a still image when animation is disabled");
+  TEST_ASSERT(!image.is_animated && image.frame_count == 0 &&
+              image.frames == NULL && image.frame_delays_ms == NULL,
+              "Disabled animation retains no frame collection or delays");
+  TEST_ASSERT(image.width == 2 && image.height == 1 && image.channels == 4,
+              "Still GIF retains its complete RGBA canvas");
+  TEST_ASSERT(pixel_is(image.data, 255, 0, 0, 255) &&
+              pixel_is(image.data + 4, 255, 0, 0, 255),
+              "Disabled animation displays first-frame pixels, not the last frame");
+  chroma_anim_advance_frame(&image, 1000);
+  chroma_anim_advance_frame(&image, 1100);
+  TEST_ASSERT(pixel_is(image.data, 255, 0, 0, 255),
+              "Still GIF cannot advance to a later frame");
+  return TEST_PASSED;
+}
+
+static int test_gif_cache_animation_toggles(void) {
+  state.config.animation_enabled = false;
+  for (int i = 0; i < 3; i++) {
+    state.outputs[i].width = 2;
+    state.outputs[i].height = 1;
+  }
+  TEST_ASSERT(chroma_image_assign(&state, &state.outputs[0], gif_path) == CHROMA_OK &&
+              chroma_image_assign(&state, &state.outputs[1], gif_path) == CHROMA_OK,
+              "Two outputs acquire the disabled GIF");
+  chroma_image_t *shared = state.outputs[0].image;
+  TEST_ASSERT(shared == state.outputs[1].image && shared->ref_count == 2 &&
+              !shared->is_animated && shared->frames == NULL,
+              "Disabled GIF cache shares one still allocation");
+
+  state.config.animation_enabled = true;
+  TEST_ASSERT(chroma_image_assign(&state, &state.outputs[0], gif_path) == CHROMA_OK,
+              "Enabling animation upgrades an already assigned path");
+  TEST_ASSERT(state.outputs[0].image == shared && state.outputs[1].image == shared &&
+              shared->ref_count == 2 && shared->is_animated && shared->frame_count == 3,
+              "Animation upgrade preserves shared ownership and loads all frames");
+  chroma_anim_advance_frame(shared, 1000);
+  chroma_anim_advance_frame(shared, 1100);
+  TEST_ASSERT(shared->current_frame == 1 && shared->data == shared->frames[1] &&
+              pixel_is(state.outputs[1].image->data, 0, 0, 255, 255),
+              "Upgraded cache plays with the original frame timing on both outputs");
+
+  TEST_ASSERT(chroma_image_assign(&state, &state.outputs[2], "color:#FF112233") == CHROMA_OK,
+              "Third output owns a different image before switching");
+  chroma_image_t *previous = state.outputs[2].image;
+  state.config.animation_enabled = false;
+  TEST_ASSERT(chroma_image_assign(&state, &state.outputs[2], gif_path) == CHROMA_OK,
+              "Disabling animation replaces a currently playing cached GIF");
+  TEST_ASSERT(state.outputs[0].image == shared && state.outputs[1].image == shared &&
+              state.outputs[2].image == shared && shared->ref_count == 3 && !previous->loaded,
+              "Mode replacement retains all owners and releases the switched-away image");
+  TEST_ASSERT(!shared->is_animated && shared->frames == NULL &&
+              shared->frame_delays_ms == NULL && shared->frame_count == 0 &&
+              shared->current_frame == 0 && shared->last_frame_ms == 0,
+              "Disabling animation drops frame storage and playback state");
+  TEST_ASSERT(pixel_is(shared->data, 255, 0, 0, 255) &&
+              pixel_is(shared->data + 4, 255, 0, 0, 255),
+              "Disabling playback restores the first frame for every cache owner");
+
+  chroma_image_release(state.outputs[2].image);
+  state.outputs[2].image = NULL;
+  chroma_image_release(state.outputs[1].image);
+  state.outputs[1].image = NULL;
+  TEST_ASSERT(shared->loaded && shared->ref_count == 1 &&
+              pixel_is(state.outputs[0].image->data, 255, 0, 0, 255),
+              "Releasing shared owners preserves the last output's pixels");
+  chroma_image_release(state.outputs[0].image);
+  state.outputs[0].image = NULL;
+  TEST_ASSERT(!shared->loaded && shared->data == NULL && shared->ref_count == 0,
+              "Final release frees the replacement still image");
+  return TEST_PASSED;
+}
