Date: Mon, 23 Nov 2026 10:57:28 +0300
Subject: [PATCH] I hate SCTK

Signed-off-by: NotAShelf <raf@notashelf.dev>
Change-Id: Ifc693fd2a866d7d7a54438bc24fc091f6a6a6964
---
 Cargo.lock                     |  2 --
 Cargo.toml                     |  1 -
 crates/beer-wayland/Cargo.toml |  1 -
 crates/beer-wayland/src/run.rs | 65 +++++++++++++++++++++++++++-------
 crates/beer/Cargo.toml         |  1 -
 5 files changed, 53 insertions(+), 17 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index cd7776a..367c8ce 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -60,7 +60,6 @@ dependencies = [
  "beer-wayland",
  "beer-window",
  "calloop",
- "calloop-wayland-source",
  "caress",
  "flate2",
  "flub",
@@ -116,7 +115,6 @@ dependencies = [
  "beer-protocols",
  "beer-window",
  "calloop",
- "calloop-wayland-source",
  "misstep",
  "rustix",
  "smithay-client-toolkit",
diff --git a/Cargo.toml b/Cargo.toml
index 688ce52..aed3725 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -29,7 +29,6 @@ beer-wayland   = { path = "crates/beer-wayland", version = "0.15.0" }
 caress = "0.3.0"
 jiff = { version = "1.0.1", default-features = false, features = [ "std" ] }
 calloop = { version = "0.14.5", features = [ "signals" ] }
-calloop-wayland-source = "0.4.1"
 flate2 = "1.1.11"
 flub = "0.1.0"
 fontconfig = "0.11.0"
diff --git a/crates/beer-wayland/Cargo.toml b/crates/beer-wayland/Cargo.toml
index ea311fc..8635f8b 100644
--- a/crates/beer-wayland/Cargo.toml
+++ b/crates/beer-wayland/Cargo.toml
@@ -11,7 +11,6 @@ readme                 = "README.md"
 beer-protocols.workspace         = true
 beer-window.workspace            = true
 calloop.workspace                = true
-calloop-wayland-source.workspace = true
 misstep.workspace                = true
 rustix.workspace                 = true
 smithay-client-toolkit.workspace = true
diff --git a/crates/beer-wayland/src/run.rs b/crates/beer-wayland/src/run.rs
index adf283d..7362f2d 100644
--- a/crates/beer-wayland/src/run.rs
+++ b/crates/beer-wayland/src/run.rs
@@ -2,14 +2,18 @@
 //! [`WaylandState`], let the app start (arm timers, bind the IPC socket, open
 //! the first window), then run the calloop loop until the app exits.
 
-use std::collections::HashMap;
+use std::{collections::HashMap, io::ErrorKind};
 
 use beer_window::{App, WindowId};
 use calloop::{
+  Dispatcher,
   EventLoop,
+  Interest,
+  Mode,
+  PostAction,
+  generic::Generic,
   signals::{Signal, Signals},
 };
-use calloop_wayland_source::WaylandSource;
 use misstep::ResultExt as _;
 use smithay_client_toolkit::{
   activation::ActivationState,
@@ -25,8 +29,10 @@ use smithay_client_toolkit::{
 use wayland_client::{
   Connection,
   Dispatch,
+  DispatchError,
   Proxy,
   QueueHandle,
+  backend::WaylandError,
   globals::{GlobalList, registry_queue_init},
 };
 use wayland_protocols::wp::{
@@ -68,15 +74,37 @@ where
 pub fn run(app: Box<dyn App>) -> misstep::Result<u8> {
   let conn =
     Connection::connect_to_env().context("connect to Wayland compositor")?;
-  let (globals, event_queue) =
+  let (globals, mut event_queue) =
     registry_queue_init(&conn).context("initialize Wayland registry")?;
   let qh = event_queue.handle();
 
   let mut event_loop: EventLoop<WaylandState> =
     EventLoop::try_new().context("create calloop event loop")?;
-  WaylandSource::new(conn, event_queue)
-    .insert(event_loop.handle())
-    .map_err(|e| misstep::report!("insert Wayland source: {e}"))?;
+  // A socket read can drop SCTK keyboard state, which removes a repeat
+  // timer. Read in a regular callback, where calloop isn't borrowing its
+  // source list, rather than in WaylandSource's pre-dispatch hook.
+  // Dispatch messages here too, so releases reach SCTK before repeat timers.
+  let display = Dispatcher::new(
+    Generic::new_with_error(conn.clone(), Interest::READ, Mode::Level),
+    move |ready, conn, state: &mut WaylandState| -> Result<_, DispatchError> {
+      if ready.readable || ready.error {
+        if let Some(read) = conn.prepare_read() {
+          match read.read() {
+            Ok(_) => {},
+            Err(WaylandError::Io(err))
+              if err.kind() == ErrorKind::WouldBlock => {},
+            Err(err) => return Err(err.into()),
+          }
+        }
+        event_queue.dispatch_pending(state)?;
+      }
+      Ok(PostAction::Continue)
+    },
+  );
+  let loop_handle = event_loop.handle();
+  let display_token = loop_handle
+    .register_dispatcher(display.clone())
+    .context("register Wayland socket")?;
 
   let compositor =
     CompositorState::bind(&globals, &qh).context("compositor not available")?;
@@ -102,7 +130,7 @@ pub fn run(app: Box<dyn App>) -> misstep::Result<u8> {
     output_state: OutputState::new(&globals, &qh),
     seat_state: SeatState::new(&globals, &qh),
     shm,
-    loop_handle: event_loop.handle(),
+    loop_handle: loop_handle.clone(),
     qh: qh.clone(),
     compositor,
     xdg_shell,
@@ -168,12 +196,7 @@ pub fn run(app: Box<dyn App>) -> misstep::Result<u8> {
     Err(err) => tracing::warn!("install signal handlers: {err}"),
   }
 
-  // Each iteration blocks until an event arrives, then repaints any window the
-  // app has marked and that is not waiting on a frame callback.
   while !state.plat.exit {
-    event_loop
-      .dispatch(None, &mut state)
-      .context("dispatch event loop")?;
     let ids: Vec<WindowId> = state
       .plat
       .windows
@@ -188,6 +211,24 @@ pub fn run(app: Box<dyn App>) -> misstep::Result<u8> {
       }
       app.render(plat, id);
     }
+    if state.plat.exit {
+      break;
+    }
+
+    let write_pending = match conn.flush() {
+      Ok(()) => false,
+      Err(WaylandError::Io(err)) if err.kind() == ErrorKind::WouldBlock => true,
+      Err(err) => Err(err).context("flush Wayland requests")?,
+    };
+    if display.as_source_ref().interest.writable != write_pending {
+      display.as_source_mut().interest.writable = write_pending;
+      loop_handle
+        .update(&display_token)
+        .context("update Wayland socket interest")?;
+    }
+    event_loop
+      .dispatch(None, &mut state)
+      .context("dispatch event loop")?;
   }
   Ok(state.plat.exit_code)
 }
