index d38c184..8f5807b 100644
--- a/crates/beer/Cargo.toml
+++ b/crates/beer/Cargo.toml
@@ -14,7 +14,6 @@ beer-protocols.workspace         = true
 beer-wayland.workspace           = true
 beer-window.workspace            = true
 calloop.workspace                = true
-calloop-wayland-source.workspace = true
 caress.workspace                 = true
 flate2.workspace                 = true
 flub.workspace                   = true
