From: fazzi <faaris.ansari@proton.me>
Date: Wed, 18 Nov 2026 23:37:18 +0000
Subject: [PATCH] xtask: jiff 1.0 breaking change

---
 xtask/src/main.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/xtask/src/main.rs b/xtask/src/main.rs
index 06c51b1..916a881 100644
--- a/xtask/src/main.rs
+++ b/xtask/src/main.rs
@@ -67,6 +67,6 @@ fn man_date() -> Result<String, Box<dyn Error>> {
     Err(VarError::NotPresent) => Timestamp::now(),
     Err(error) => return Err(error.into()),
   };
-  let date = timestamp.to_zoned(TimeZone::UTC).date();
+  let date = timestamp.to_zoned_datetime(TimeZone::UTC).date();
   Ok(date.strftime("%B %-d, %Y").to_string())
 }
