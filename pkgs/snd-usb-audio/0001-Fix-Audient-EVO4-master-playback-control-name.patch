++			| SNDRV_CTL_ELEM_ACCESS_VOLATILE;
++	uinfo->count = snd_evo_kctl_channels(kctl);
++	uinfo->value.integer.min = ctype->min.integer;
++	uinfo->value.integer.max = ctype->max.integer;
